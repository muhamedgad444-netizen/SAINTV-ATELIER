# Neon Postgres connection string (provision via Vercel Marketplace: `vercel integration add neon`)
DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/saintv?sslmode=require"

# Frontend origin allowed for CORS (defaults to "*" if unset)
ALLOWED_ORIGIN="http://127.0.0.1:5174"

# Secret header key (`x-admin-key`) protecting admin write/order-listing endpoints
ADMIN_API_KEY="replace-with-a-strong-random-secret"

# Local dev server port (used by `npm run dev` in backend/)
PORT=3001
